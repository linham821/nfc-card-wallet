<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- PassKit：允许 App 调起 PKAddPassesViewController 加入 Wallet Pass -->
    <key>com.apple.developer.pass-type-identifiers</key>
    <array>
        <string>pass.com.nfccardwallet.app</string>
    </array>

    <!-- 说明：
         NFC Reader Session entitlement 已移除。
         原因：Free Apple ID 无法获取此 capability，运行时 readingAvailable 返回 false。
         App 改为手动输入/扫码/JSON 导入方式录入卡片信息。
         如以后获得付费 Apple Developer Program 会员资格，可在此重新添加：
            <key>com.apple.developer.nfc.readersession</key>
            <true/>
         并在 Info.plist 恢复 NFCReaderUsageDescription 和 iso7816/felica 配置。
    -->
</dict>
</plist>
